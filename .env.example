# =============================================================================
# Invoice Generator — environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored. Never commit real secrets.
# Variables are grouped to match `docs/Tech.md` §3.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Public Supabase URL — visible to the browser
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key — visible to the browser, used by browser/server SSR clients
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key — SERVER ONLY. Used by the Stripe webhook handler to bypass RLS.
# NEVER expose this to the browser and NEVER commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Private Supabase Storage bucket where invoice PDFs are stored
SUPABASE_STORAGE_BUCKET=invoices

# -----------------------------------------------------------------------------
# Resend (transactional email)
# -----------------------------------------------------------------------------
# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender address on your shared platform domain
# e.g. invoices@yourdomain.com
RESEND_FROM_EMAIL=

# Display name shown to recipients in the From header.
# The runtime From is composed as: "{sender_name_from_profile} <RESEND_FROM_EMAIL>"
# This is the fallback used when the sender's profile has no full name.
RESEND_FROM_NAME=Invoice Generator

# -----------------------------------------------------------------------------
# Stripe (Connect Express + Checkout Sessions)
# -----------------------------------------------------------------------------
# Platform secret key. Use a `sk_test_...` key in development.
STRIPE_SECRET_KEY=

# Webhook signing secret from the Stripe dashboard for this endpoint.
# In development, use `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# and paste the printed `whsec_...` value here.
STRIPE_WEBHOOK_SECRET=

# Absolute URLs Stripe redirects users back to during Connect onboarding.
# `refresh` is hit when the onboarding link expires; `return` is hit on completion.
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/settings/payments?stripe=refresh
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/settings/payments?stripe=return

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Absolute base URL of this deployment. Used to build Stripe success/cancel URLs
# and any other absolute links generated by the server.
NEXT_PUBLIC_APP_URL=http://localhost:3000
